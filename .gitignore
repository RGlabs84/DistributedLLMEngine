# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# --- PyInstaller / build output ---
# Regenerated by builder/build_all_releases.ps1; ~160 MB of binaries.
build/
dist/
*.exe
*.manifest
pyarmor.bug.log

# --- Manual backup tree ---
# 222 MB snapshot kept on disk as-is. Git now provides history, so this
# folder is deliberately untracked rather than duplicated into the repo.
DLNE Backup - No Modifications Allowed/
diff.txt

# --- Runtime state (generated at first launch by setup_cli.py) ---
# config.txt holds ADMIN_HASH and NETWORK_KEY; .dlne_token / .dlne_id are
# per-node identity; .chat_key_enc is the WebUI chat vault key.
config/
logs/
*.log

# --- Encrypted vaults ---
*.enc

# --- Credentials ---
.env
**/.env
# Release signing keys. The real one lives outside this tree entirely
# (see engine/version.py RELEASE_PUBKEY); this rule is a second lock, so a key
# generated into the repo by accident cannot be committed.
*.pem
*.key
# The Discord bot token, when supplied by file rather than by environment variable
# (see discord/scripts/bot_token.py). A bearer credential must never be tracked.
discord/scripts/.bot_token

# --- WireGuard tunnel identities ---
# Every .conf here carries a PrivateKey and a real endpoint address. worker_invite.conf was
# tracked before this rule existed; it is untracked now and the key it held is dead.
*.conf
wg_configs/

# Join files carry no private key - that is the point of them - but they do carry the
# cluster's NETWORK_KEY, which is the secret that authorises joining at all.
*.dlnejoin

# --- Model blobs (multi-GB GGUF downloads) ---
models/
*.gguf

# --- Pre-remediation snapshot (local only, never published) ---
_backup_pre_remediation_*.zip

# --- Scratch ---
temp.exe
test.exe
test_ping.dat
file1.txt
file2.txt
hello_world
hello_world.rs

# --- Binaries & Extension Builds ---
bin/
rpc_cache/
*.vsix
node_modules/


# Local session handoff (contains infra details)
RESUME_HANDOFF.md

# Output of scripts/release.py (archive + signed manifest); never committed.
release_dist/

# The maintainer's working notes and scratch files: kept locally, never published.
.agent_rules.md
To-Do.md
Next direction.md
implementation_plan.md
recover.bat
generate_sh.py
hello_world.py
update_staging/
