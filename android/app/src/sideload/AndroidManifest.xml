<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Sideload build only (the APK from the DLNE website; never in the Google Play build).
        Lets the in-app updater hand a downloaded, verified update to Android's installer.
        Android still asks the person to confirm every install.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Receives the installer's progress (confirmation needed, done, failed). Internal only. -->
        <receiver
            android:name="io.dlne.chat.update.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
